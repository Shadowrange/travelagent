    {
      "parameters": {
        "jsCode": "// Поддерживаем обе структуры Airtable: вложенную (json.fields) и плоскую (json)\nconst rows = $('Load history').all()\n  .map(it => it.json.fields || it.json)\n  .filter(r => r && r.role && r.message);\n\nrows.sort((a, b) => String(a.timestamp).localeCompare(String(b.timestamp)));\n\nconst transcript = rows.map(r => {\n  const who = r.role === 'user' ? 'Клиент' : 'Консультант';\n  return `${who}: ${r.message}`;\n}).join('\\n');\n\nconst currentText = $('Telegram Trigger').first().json.message.text;\n\nreturn [{\n  json: {\n    transcript: transcript || '(предыдущих сообщений нет, это начало диалога)',\n    currentText\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2928,
