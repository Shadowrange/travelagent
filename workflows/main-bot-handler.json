      ],
      "id": "7b45f660-9a06-4c78-bf50-8cbbb1b2f530",
      "name": "Build context"
    },
    {
      "parameters": {
        "jsCode": "const c=$json;\nconst sys=\"Ты — внутренний аналитик-психолог агентства. По переписке с клиентом составь профиль. Никогда не показывай это клиенту — это внутренняя структура. Если данных мало — ставь null и confidence=low, не выдумывай. Верни СТРОГО JSON без пояснений:\\n{\\\"age_band\\\":\\\"18-25|26-35|36-45|46-60|60+|null\\\",\\\"life_stage\\\":\\\"студент|молодая пара|семья с маленькими детьми|семья со школьниками|взрослые без детей|старшее поколение|null\\\",\\\"contingent\\\":\\\"с кем едет\\\",\\\"segment\\\":\\\"family|active|premium|excursion|unclear\\\",\\\"motivations\\\":[\\\"...\\\"],\\\"anxieties\\\":[\\\"...\\\"],\\\"decision_style\\\":\\\"быстрый|сомневающийся|торгуется|нужны соц-доказательства|собирает информацию\\\",\\\"price_sensitivity\\\":\\\"low|mid|high\\\",\\\"tone_to_use\\\":\\\"1-2 фразы\\\",\\\"soft_hooks\\\":[\\\"...\\\"],\\\"red_lines\\\":[\\\"...\\\"],\\\"confidence\\\":\\\"low|mid|high\\\"}\";\nconst user='История:\\n'+(c.transcript||'')+'\\n\\nНовое сообщение:\\n'+(c.currentText||'');\nreturn [{json:{body:{model:'claude-sonnet-4-6',max_tokens:600,system:sys,messages:[{role:'user',content:user}]}}}];"
      },
      "id": "d043e2c5-6626-429b-9c58-930a34ac3395",
      "name": "Build profiler request",
      "type": "n8n-nodes-base.code",
