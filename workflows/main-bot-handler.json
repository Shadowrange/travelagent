    {
      "parameters": {
        "jsCode": "let profile='';try{const r=$('Profile client').first().json;profile=(r.content&&r.content[0]&&r.content[0].text)||r.completion||'';}catch(e){}\nconst c=$('Build context').first().json;\nreturn [{json:{transcript:c.transcript||'',currentText:c.currentText||'',profile}}];"
      },
