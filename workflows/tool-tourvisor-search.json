    {
      "parameters": {
        "jsCode": "const resp=$json;const init=$('Init poll').first().json;\nconst st=String(resp.status||'').toLowerCase();const prog=resp.progress||0;\nconst finished=st.indexOf('finish')>-1||st.indexOf('закон')>-1||prog>=100||$runIndex>=8;\nreturn [{json:{finished,status:resp.status||'',progress:prog,runIndex:$runIndex,resultUrl:init.resultUrl,statusUrl:init.statusUrl}}];"
      },
