    {
      "parameters": {
        "jsCode": "const arr=Array.isArray($json)?$json:($json.hotels||[]);\nconst top=arr.slice(0,3).map((h,i)=>{const t=(h.tours&&h.tours[0])||{};\n const op=(t.operator&&t.operator.russianName)||(t.operator&&t.operator.name)||'';\n const meal=(t.meal&&t.meal.russianName)||'';const reg=(h.region&&h.region.name)||'';\n return `${i+1}. ${h.name}${h.category?(' '+h.category+'*'):''} (${reg}) — от ${h.price} руб.\\n   ${t.nights||''} ноч., ${meal}, оператор ${op}\\n   ${h.hotelDescriptionLink||''}`;\n}).join('\\n\\n');\nreturn [{json:{results_text: top||'Пока без подходящих туров — уточни параметры или предложи передать менеджеру.',count:arr.length}}];"
      },
