      "id": "7c8d198e-4783-4f03-aaf3-bd98bf2ada89",
      "name": "Get departures",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -688,
        96
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const p = $json;\nconst countries = $('Get countries').all().map(i => i.json);\nconst departures = $('Get departures').all().map(i => i.json);\n\nfunction findId(arr, name, def) {\n  const q = String(name || '').toLowerCase().trim();\n  if (!q) return def;\n  const f = arr.find(x => {\n    const n = String(x.name || '').toLowerCase();\n    return n === q || n.includes(q) || q.includes(n);\n  });\n  return f ? f.id : def;\n}\n\n// дефолтные даты: ближайшее окно вылета, если ИИ/тест не передал\nfunction isoPlus(days) {\n  return new Date(Date.now() + days * 86400000).toISOString().slice(0, 10);\n}\nconst dateFrom = (p.dateFrom && String(p.dateFrom).trim()) || isoPlus(14);\nconst dateTo   = (p.dateTo   && String(p.dateTo).trim())   || isoPlus(28);\n\nconst countryId = findId(countries, p.country, 4);\nconst departureId = findId(departures, p.city_from || 'Москва', 1);\n\nconst params = {\n  departureId: String(departureId),\n  countryId: String(countryId),\n  dateFrom: dateFrom,\n  dateTo: dateTo,\n  nightsFrom: String(p.nightsFrom || 7),\n  nightsTo: String(p.nightsTo || 10),\n  adults: String(p.adults || 2),\n  currency: p.currency || 'RUB',\n  onlyCharter: 'false'\n};\n\nconst enc = encodeURIComponent;\nlet qs = Object.keys(params).map(k => enc(k) + '=' + enc(params[k])).join('&');\n\nString(p.childs || '').split(',').map(s => s.trim()).filter(Boolean)\n  .forEach(a => { qs += '&childs=' + enc(a); });\n\nreturn [{ json: {\n  searchUrl: 'https://api.tourvisor.ru/search/api/v1/tours/search?' + qs,\n  countryId,\n  departureId,\n  dateFrom,\n  dateTo\n} }];"
      },
      "id": "82a845cb-1ba8-4589-98a3-4fc32ff0bf41",
